{
  "name": "Sync a Drive folder to a vector store",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {}
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -32,
        336
      ],
      "id": "66e6dbee-12cb-4739-976a-7b04e8812c83",
      "name": "On a schedule"
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "searchMethod": "query",
        "returnAll": true,
        "filter": {
          "driveId": {
            "__rl": true,
            "value": "YOUR_SHARED_DRIVE_ID",
            "mode": "list",
            "cachedResultName": "Your shared drive"
          },
          "folderId": {
            "__rl": true,
            "value": "YOUR_DRIVE_FOLDER_ID",
            "mode": "list",
            "cachedResultName": "Your folder"
          },
          "whatToSearch": "files"
        },
        "options": {
          "fields": [
            "*"
          ]
        }
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        192,
        336
      ],
      "id": "19e12dbe-85db-44bd-a08e-3e125cc5b9c3",
      "name": "List folder files",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "load",
        "pineconeIndex": {
          "__rl": true,
          "value": "YOUR_INDEX_NAME",
          "mode": "list",
          "cachedResultName": "YOUR_INDEX_NAME"
        },
        "prompt": "={{ $json.name }}",
        "topK": 1,
        "options": {
          "pineconeNamespace": "documents",
          "metadata": {
            "metadataValues": [
              {
                "name": "file_id",
                "value": "={{ $json.id }}"
              }
            ]
          }
        }
      },
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1.3,
      "position": [
        640,
        656
      ],
      "id": "bc86c668-eed7-4b71-ab7a-f467a9028336",
      "name": "Look up this file in the index"
    },
    {
      "parameters": {
        "options": {},
        "model": "text-embedding-3-small"
      },
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [
        712,
        888
      ],
      "id": "6942b47d-24cc-4866-b41d-2796270b1057",
      "name": "Embeddings for lookup"
    },
    {
      "parameters": {
        "mode": "combine",
        "advanced": true,
        "mergeByFields": {
          "values": [
            {
              "field1": "id",
              "field2": "document.metadata.file_id"
            }
          ]
        },
        "joinMode": "keepEverything",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        992,
        544
      ],
      "id": "c2796d44-979c-40df-8fb5-3a9d9fac7fa7",
      "name": "Pair file with index entry"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "759313a0-3283-4db2-b3d7-d7048a51c043",
              "leftValue": "={{ $json.document }}",
              "rightValue": "",
              "operator": {
                "type": "object",
                "operation": "empty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1216,
        544
      ],
      "id": "0ca86219-a214-4f0e-87d6-65440dbaa990",
      "name": "Never indexed?"
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $('List folder files').item.json.id }}",
          "mode": "id"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1632,
        528
      ],
      "id": "cf432d51-17d5-4a41-afd5-1abb1b6711ae",
      "name": "Download file",
      "retryOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "56718516-5caf-4409-bc6b-75ceb3fc3ea8",
              "leftValue": "={{ $('List folder files').item.json.modifiedTime }}",
              "rightValue": "={{ $json.document.metadata.last_modified }}",
              "operator": {
                "type": "dateTime",
                "operation": "after"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1424,
        656
      ],
      "id": "5d9cb597-e650-46db-a592-23f0ec903dd0",
      "name": "Changed since it was indexed?"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1632,
        752
      ],
      "id": "3e032cfc-ad46-4d26-bea7-3aaf73d6b385",
      "name": "Nothing to do"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_INDEX_HOST/vectors/delete",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "pineconeApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"namespace\": \"documents\",\n  \"filter\": {\n    \"file_id\": { \"$eq\": \"{{ $('Download file').item.json.id }}\" },\n    \"last_modified\": { \"$ne\": \"{{ $('Download file').item.json.modifiedTime }}\" }\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2256,
        528
      ],
      "id": "53f61241-b823-4795-9d24-b18297c171a7",
      "name": "Delete the old version",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "executeOnce": true
    },
    {
      "parameters": {
        "mode": "insert",
        "pineconeIndex": {
          "__rl": true,
          "value": "YOUR_INDEX_NAME",
          "mode": "list",
          "cachedResultName": "YOUR_INDEX_NAME"
        },
        "embeddingBatchSize": 1,
        "options": {
          "pineconeNamespace": "documents"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1.3,
      "position": [
        1904,
        528
      ],
      "id": "9a6f3566-7fae-4096-9bc9-8dff9fd70595",
      "name": "Index the passages"
    },
    {
      "parameters": {
        "options": {},
        "model": "text-embedding-3-small"
      },
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [
        1888,
        704
      ],
      "id": "28f4fa5e-c26b-4925-a71b-3322b4e92886",
      "name": "Embeddings for writing"
    },
    {
      "parameters": {
        "dataType": "binary",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "file_id",
                "value": "={{ $('Download file').item.json.id }}"
              },
              {
                "name": "file_name",
                "value": "={{ $('Download file').item.json.name }}"
              },
              {
                "name": "last_modified",
                "value": "={{ $('Download file').item.json.modifiedTime }}"
              }
            ]
          }
        }
      },
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        2064,
        704
      ],
      "id": "ab26c8f3-fbd8-491d-9c3c-20264cf57b6c",
      "name": "Read the document"
    },
    {
      "parameters": {
        "mode": "perItem",
        "minutesSaved": 5
      },
      "type": "n8n-nodes-base.timeSaved",
      "typeVersion": 1,
      "position": [
        2480,
        528
      ],
      "id": "b5c9a73c-8fa5-46a6-bf25-03226fc0ddb5",
      "name": "Time Saved"
    },
    {
      "parameters": {
        "fieldsToAggregate": {
          "fieldToAggregate": [
            {
              "fieldToAggregate": "id"
            }
          ]
        },
        "options": {}
      },
      "id": "2b3fc199-3658-487d-b732-6b2459685a18",
      "name": "Collect current file ids",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        416,
        128
      ],
      "notes": "One item holding every file id currently in the folder. The sweep deletes anything else."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "guard-empty-listing",
              "leftValue": "={{ $json.id }}",
              "operator": {
                "type": "array",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "16d6914c-a5ba-46f5-a262-ca2d4db0ddbe",
      "name": "Any files in the folder?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        704,
        128
      ],
      "notes": "Both branches act. Files present: delete every passage whose file_id is not among them. Folder empty: clear the namespace, because an empty folder should mean an empty index. An empty listing only happens when the Drive call succeeded and found nothing, since a failed call errors the run rather than returning zero items."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_INDEX_HOST/vectors/delete",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "pineconeApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"namespace\": \"documents\",\n  \"filter\": {\n    \"file_id\": { \"$nin\": {{ JSON.stringify($json.id) }} }\n  }\n}",
        "options": {}
      },
      "id": "2ce55b17-7495-48ee-bb4f-6541f855f8d1",
      "name": "Delete files no longer in the folder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        992,
        32
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "notes": "Deletes every passage whose file_id is not in the current listing. This is what handles a file being deleted or moved out of the folder, which the per-file path never sees."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "has-a-file-id",
              "leftValue": "={{ $json.id }}",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "c67c3b80-f841-4b20-a6b9-b40486b30324",
      "name": "Only real files",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        416,
        528
      ],
      "notes": "The listing emits one empty placeholder item when the folder is empty, so the sweep can still see that. This keeps that placeholder out of the per-file path, where it would reach the embedding as undefined."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_INDEX_HOST/vectors/delete",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "pineconeApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"namespace\": \"documents\",\n  \"deleteAll\": true\n}",
        "options": {}
      },
      "id": "4b3a1a45-dfc2-4613-b1f4-ad952ba871c3",
      "name": "Clear the namespace",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        992,
        224
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "notes": "The folder is empty, so the index should be too. A $nin against an empty list is not a valid filter, which is why this is a separate deleteAll call rather than the same node."
    }
  ],
  "pinData": {},

{
  "name": "Index a Drive folder into a vector store",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "8d2b6e63-d961-4e6d-b1c7-22c13a4a3615",
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        304
      ]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "searchMethod": "query",
        "queryString": "",
        "returnAll": true,
        "filter": {
          "folderId": {
            "__rl": true,
            "mode": "id",
            "value": "YOUR_DRIVE_FOLDER_ID"
          },
          "whatToSearch": "files"
        },
        "options": {
          "fields": [
            "*"
          ]
        }
      },
      "id": "6300dab6-0c79-446a-ac7f-4d5956ddc39c",
      "name": "List folder files",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        224,
        304
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "load",
        "pineconeIndex": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_INDEX_NAME"
        },
        "prompt": "={{ $json.name }}",
        "topK": 1,
        "includeDocumentMetadata": true,
        "options": {
          "pineconeNamespace": "documents",
          "metadata": {
            "metadataValues": [
              {
                "name": "file_id",
                "value": "={{ $json.id }}"
              }
            ]
          }
        }
      },
      "id": "e3c5c9df-122a-4610-bf2a-09589fb7a38f",
      "name": "Look up this file in the index",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1.3,
      "position": [
        448,
        432
      ],
      "notes": "The metadata filter is the lookup. The prompt is only there because load mode requires one.",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "model": "text-embedding-3-small"
      },
      "id": "3c841336-671a-4d92-b53d-c57269c62b3f",
      "name": "Embeddings for lookup",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [
        528,
        656
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByFields",
        "advanced": true,
        "mergeByFields": {
          "values": [
            {
              "field1": "id",
              "field2": "document.metadata.file_id"
            }
          ]
        },
        "joinMode": "keepEverything",
        "options": {}
      },
      "id": "59f5082f-89c9-4e23-b84f-d7156d0c5683",
      "name": "Pair file with index entry",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        800,
        304
      ],
      "notes": "Left join. A file with no index entry comes out with an empty document."
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.document }}",
              "rightValue": "",
              "operator": {
                "type": "object",
                "operation": "empty",
                "singleValue": true
              }
            }
          ]
        },
        "looseTypeValidation": true
      },
      "id": "0879deea-0eeb-4c9c-8fab-592e295f21ff",
      "name": "Never indexed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1024,
        304
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $('List folder files').item.json.modifiedTime }}",
              "rightValue": "={{ $json.document.metadata.last_modified }}",
              "operator": {
                "type": "dateTime",
                "operation": "after"
              }
            }
          ]
        }
      },
      "id": "0d3855eb-8469-45fb-b8cb-9f06cb9fea25",
      "name": "Changed since it was indexed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1248,
        384
      ],
      "notes": "Newer than the timestamp written at index time, or nothing happens."
    },
    {
      "parameters": {},
      "id": "5b96acff-5bce-42a5-9a26-934565c48f99",
      "name": "Nothing to do",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1472,
        432
      ],
      "notes": "Already indexed and untouched. No download, no embedding, no write."
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "download",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('List folder files').item.json.id }}"
        },
        "options": {
          "binaryPropertyName": "data",
          "googleFileConversion": {
            "conversion": {
              "docsToFormat": "text/plain"
            }
          }
        }
      },
      "id": "7d132cf5-31e2-41b7-8f97-a4ce39101882",
      "name": "Download file",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1472,
        208
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Downloaded before anything is deleted, so a failure here leaves the existing passages untouched."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_INDEX_HOST/vectors/delete",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "pineconeApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ namespace: \"documents\", filter: { file_id: { $eq: $('List folder files').item.json.id } } }) }}"
      },
      "id": "97463929-394b-438d-bc94-0194cbdcda52",
      "name": "Delete previous chunks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1696,
        288
      ],
      "notes": "Harmless for a file that was never indexed: the filter simply matches nothing.",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "chooseBranch",
        "numberInputs": 2,
        "chooseBranchMode": "waitForAll",
        "output": "specifiedInput",
        "useDataOfInput": "1"
      },
      "id": "95b22b05-a175-41da-b2e6-a4365155b06a",
      "name": "Wait for the delete",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1920,
        208
      ],
      "notes": "Holds the downloaded file until the delete has finished, then passes the file through. Without this the insert could race the delete and lose the new passages."
    },
    {
      "parameters": {
        "mode": "insert",
        "pineconeIndex": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_INDEX_NAME"
        },
        "embeddingBatchSize": 1,
        "options": {
          "pineconeNamespace": "documents"
        }
      },
      "id": "b7c73451-e570-4494-ae6b-a5109ac93264",
      "name": "Index the passages",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1.3,
      "position": [
        2144,
        208
      ]
    },
    {
      "parameters": {
        "model": "text-embedding-3-small"
      },
      "id": "d1d04a77-98d2-452c-a640-95887eeef00a",
      "name": "Embeddings for writing",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [
        2160,
        432
      ]
    },
    {
      "parameters": {
        "dataType": "binary",
        "binaryMode": "allInputData",
        "loader": "auto",
        "textSplittingMode": "custom",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "file_id",
                "value": "={{ $('List folder files').item.json.id }}"
              },
              {
                "name": "file_name",
                "value": "={{ $('List folder files').item.json.name }}"
              },
              {
                "name": "last_modified",
                "value": "={{ $('List folder files').item.json.modifiedTime }}"
              }
            ]
          }
        }
      },
      "id": "82f9e9a8-96d0-4d0e-9638-1f3dba579952",
      "name": "Read the document",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        2288,
        432
      ],
      "notes": "last_modified is what the next run compares against. Without it there is no change detection."
    },
    {
      "parameters": {
        "chunkSize": 1000,
        "chunkOverlap": 200
      },
      "id": "89ea3879-8d7f-4826-8aad-0027c92fc81f",
      "name": "Split into passages",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        2288,
        640
      ]
    },
    {
      "parameters": {
        "content": "### Only new and changed files are written\nEvery pass looks each file up by `file_id`. No entry means new. An entry means compare Drive `modifiedTime` against the `last_modified` written at index time, and stop unless it is newer.\n\nThe file is downloaded **before** anything is deleted, and the insert waits for the delete, so a failed download never leaves the index missing a document.",
        "height": 260,
        "width": 460,
        "color": 4
      },
      "id": "d709a68f-1f20-44d3-8c4e-9b5ae8bea413",
      "name": "Only new and changed files are written",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1072,
        640
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Every hour": {
      "main": [
        [
          {
            "node": "List folder files",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List folder files": {
      "main": [
        [
          {
            "node": "Pair file with index entry",
            "type": "main",
            "index": 0
          },
          {
            "node": "Look up this file in the index",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Look up this file in the index": {
      "main": [
        [
          {
            "node": "Pair file with index entry",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Embeddings for lookup": {
      "ai_embedding": [
        [
          {
            "node": "Look up this file in the index",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    },
    "Pair file with index entry": {
      "main": [
        [
          {
            "node": "Never indexed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Never indexed?": {
      "main": [
        [
          {
            "node": "Download file",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Changed since it was indexed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Changed since it was indexed?": {
      "main": [
        [
          {
            "node": "Download file",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Nothing to do",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download file": {
      "main": [
        [
          {
            "node": "Wait for the delete",
            "type": "main",
            "index": 0
          },
          {
            "node": "Delete previous chunks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Delete previous chunks": {
      "main": [
        [
          {
            "node": "Wait for the delete",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Wait for the delete": {
      "main": [
        [
          {
            "node": "Index the passages",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Embeddings for writing": {
      "ai_embedding": [
        [
          {
            "node": "Index the passages",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    },
    "Read the document": {
      "ai_document": [
        [
          {
            "node": "Index the passages",
            "type": "ai_document",
            "index": 0
          }
        ]
      ]
    },
    "Split into passages": {
      "ai_textSplitter": [
        [
          {
            "node": "Read the document",
            "type": "ai_textSplitter",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate",
    "availableInMCP": true
  },
  "nodeGroups": []
}

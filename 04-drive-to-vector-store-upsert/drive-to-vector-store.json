{
  "name": "Index a Drive folder into a vector store",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours"
            }
          ]
        }
      },
      "id": "8d2b6e63-d961-4e6d-b1c7-22c13a4a3615",
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        304
      ]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "searchMethod": "query",
        "returnAll": true,
        "filter": {
          "folderId": {
            "__rl": true,
            "mode": "id",
            "value": "YOUR_DRIVE_FOLDER_ID"
          },
          "whatToSearch": "files"
        },
        "options": {
          "fields": [
            "*"
          ]
        }
      },
      "id": "6300dab6-0c79-446a-ac7f-4d5956ddc39c",
      "name": "List folder files",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        224,
        304
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "leftValue": "={{ $json.mimeType }}",
              "rightValue": "application/pdf",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "id": "df5b7bed-e339-46e4-a8e1-ab0addecd867"
            },
            {
              "leftValue": "={{ $json.mimeType }}",
              "rightValue": "application/vnd.google-apps.document",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "id": "aec8f48f-97f7-4795-9996-c13c236b8f2c"
            },
            {
              "leftValue": "={{ $json.mimeType }}",
              "rightValue": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "id": "fc890305-7504-4299-8567-5ce09ad4afd7"
            },
            {
              "leftValue": "={{ $json.mimeType }}",
              "rightValue": "text/plain",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "id": "ca1ba0b5-8b4f-416f-86c7-535b42a74a8a"
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "d3d2d30c-7acf-44f9-adf4-581bf8a27ffa",
      "name": "Readable document?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        448,
        304
      ],
      "notes": "Anything the loader cannot read is skipped rather than failing the run."
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        },
        "options": {
          "binaryPropertyName": "data",
          "googleFileConversion": {
            "conversion": {
              "docsToFormat": "text/plain"
            }
          }
        }
      },
      "id": "7d132cf5-31e2-41b7-8f97-a4ce39101882",
      "name": "Download file",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        672,
        208
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_INDEX_HOST/vectors/delete",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "pineconeApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ namespace: \"documents\", filter: { fileId: { $eq: $json.id } } }) }}",
        "options": {}
      },
      "id": "97463929-394b-438d-bc94-0194cbdcda52",
      "name": "Delete previous chunks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        896,
        208
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "notes": "This is what makes an edit replace rather than duplicate. A file indexed for the first time has nothing to delete, so the node continues on error."
    },
    {
      "parameters": {
        "mode": "insert",
        "pineconeIndex": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_INDEX_NAME"
        },
        "options": {
          "pineconeNamespace": "documents"
        }
      },
      "id": "b7c73451-e570-4494-ae6b-a5109ac93264",
      "name": "Index the passages",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1.3,
      "position": [
        1120,
        208
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "45d3e94c-285d-4015-885b-80f67417334f",
      "name": "Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [
        1136,
        432
      ]
    },
    {
      "parameters": {
        "dataType": "binary",
        "textSplittingMode": "custom",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "fileId",
                "value": "={{ $('Download file').item.json.id }}"
              },
              {
                "name": "fileName",
                "value": "={{ $('Download file').item.json.name }}"
              }
            ]
          }
        }
      },
      "id": "82f9e9a8-96d0-4d0e-9638-1f3dba579952",
      "name": "Read the document",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        1264,
        432
      ]
    },
    {
      "parameters": {
        "chunkOverlap": 200,
        "options": {}
      },
      "id": "89ea3879-8d7f-4826-8aad-0027c92fc81f",
      "name": "Split into passages",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        1264,
        640
      ]
    },
    {
      "parameters": {},
      "id": "c6c40104-49b2-41be-8b6c-d686fea174d6",
      "name": "Skip unreadable file",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        672,
        400
      ]
    },
    {
      "parameters": {
        "content": "### How it stays current\nEvery pass lists the folder, and each readable file has its previous chunks deleted by `fileId` before the new ones are written. That is why editing a document changes the answers instead of adding a second, stale copy of it.",
        "height": 176,
        "width": 400
      },
      "id": "29514aeb-5977-4c19-ae14-e5be6d8f2b6c",
      "name": "Sticky Note 6a6b2325",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        560,
        624
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Every hour": {
      "main": [
        [
          {
            "node": "List folder files",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List folder files": {
      "main": [
        [
          {
            "node": "Readable document?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Readable document?": {
      "main": [
        [
          {
            "node": "Download file",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Skip unreadable file",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download file": {
      "main": [
        [
          {
            "node": "Delete previous chunks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Delete previous chunks": {
      "main": [
        [
          {
            "node": "Index the passages",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Embeddings": {
      "ai_embedding": [
        [
          {
            "node": "Index the passages",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    },
    "Read the document": {
      "ai_document": [
        [
          {
            "node": "Index the passages",
            "type": "ai_document",
            "index": 0
          }
        ]
      ]
    },
    "Split into passages": {
      "ai_textSplitter": [
        [
          {
            "node": "Read the document",
            "type": "ai_textSplitter",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate",
    "availableInMCP": true
  },
  "nodeGroups": []
}

    {
      "parameters": {
        "content": "## Research and first-touch draft\nFor each new prospect: fetch the company website, find the contact and team pages, then one model call scores fit, picks the contact, and writes the email. Code then re-checks the address before anything is saved. Fit >= 60 -> Draft Ready; below -> Disqualified.",
        "height": 200,
        "width": 300,
        "color": 5
      },
      "id": "7e10dde5-51ee-4b06-ac5d-b7c8baa5e763",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -16,
        -368
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const home = (($('Fetch Company Website').item.json.data || '') + '');\nconst sitemap = (($json.data || '') + '');\nconst gp = $('Get New Prospects').item.json;\nconst base = ((gp.fields && gp.fields.Website) || gp.Website || '').toString();\nconst om = base.match(/^https?:\\/\\/[^\\/?#]+/i);\nconst origin = om ? om[0] : '';\nconst abs = (href) => { if (/^https?:\\/\\//i.test(href)) return href; if (href.charAt(0) === '/') return origin + href; return origin + '/' + href; };\nconst bad = (h) => /\\.(css|js|png|jpg|jpeg|gif|svg|webp|ico|woff2?|ttf|pdf)(\\?|#|$)/i.test(h) || /wp-content|wp-json|wp-includes|mailto:|tel:|javascript:/i.test(h);\nconst anchors = [];\nconst re = /<a\\s[^>]*href=[\"']([^\"']+)[\"'][^>]*>([\\s\\S]*?)<\\/a>/gi;\nlet mm;\nwhile ((mm = re.exec(home)) !== null) { const href = mm[1]; if (bad(href)) continue; const t = mm[2].replace(/<[^>]+>/g,' ').replace(/\\s+/g,' ').trim().toLowerCase(); anchors.push({ href: href, hay: (href + ' ' + t).toLowerCase() }); }\nconst same = (h) => { const a = abs(h); return !origin || a.indexOf(origin) === 0; };\nconst findBest = (patterns) => { for (const rx of patterns) { for (const a of anchors) { if (rx.test(a.hay) && same(a.href)) return a.href; } } return ''; };\nconst contactPats = [/contact.?us/, /\\bcontact\\b/, /get.?in.?touch/, /reach.?us/, /schedule/];\nconst teamPats = [/our.?team/, /meet.?the.?team/, /our.?people/, /leadership/, /\\bteam\\b/, /\\bpeople\\b/, /our.?company/, /\\bbios?\\b/, /profiles?/, /\\bstaff\\b/, /about.?us/, /\\babout\\b/];\nlet contactHref = findBest(contactPats);\nlet teamHref = findBest(teamPats);\nif (!contactHref || !teamHref) {\n  const locs = [];\n  const lre = /<loc>\\s*([^<\\s]+)\\s*<\\/loc>/gi; let lm;\n  while ((lm = lre.exec(sitemap)) !== null) { locs.push(lm[1]); }\n  const pickLoc = (patterns) => { for (const rx of patterns) { for (const u of locs) { if (rx.test(u) && same(u) && !bad(u)) return u; } } return ''; };\n  if (!contactHref) contactHref = pickLoc(contactPats);\n  if (!teamHref) teamHref = pickLoc(teamPats);\n}\nconst contactUrl = contactHref ? abs(contactHref) : (origin ? origin + '/contact/' : '');\nconst teamUrl = teamHref ? abs(teamHref) : (origin ? origin + '/team/' : '');\nreturn { json: { contactUrl: contactUrl, teamUrl: teamUrl, homeHtml: home } };"
      },
      "id": "968bd917-dda7-4bce-9840-4a596228467e",
      "name": "Find Contact Page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "notes": "Put the words your own market uses at the FRONT of teamPats, for example /\\battorneys?\\b/ for law firms or /\\bclinicians?\\b/ for clinics. First pattern that matches an anchor wins, then the sitemap is the fallback."
    },

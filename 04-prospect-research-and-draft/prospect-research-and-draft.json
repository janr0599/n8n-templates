      "id": "453c34aa-5889-4703-a0f2-4443a407e98b",
      "name": "OpenAI GPT-5 mini",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        1792,
        224
      ]

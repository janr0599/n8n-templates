    {
      "parameters": {
        "jsonSchemaExample": "{ \"email\": \"info@example.com\", \"contactName\": \"Rachel\", \"fitScore\": 85, \"companySize\": \"2-5\", \"focusAreas\": \"Estate Planning, Elder Law\", \"researchNotes\": \"Boston boutique estate planning company; small team; strong reviews.\", \"hooks\": \"- point one\\n- point two\", \"draftSubject\": \"a quick idea for your intake process\", \"draftBody\": \"Hi Rachel,\\n\\nI noticed your company focuses on estate planning in Boston and has excellent reviews.\\n\\nWe help small companies like yours automate intake and follow-ups so you spend less time on repetitive admin.\\n\\nWould you be open to a quick call or chat in the next week or two?\" }"
      },
      "id": "d9062a33-bee3-4089-a58a-df05e24e2357",
      "name": "Draft JSON Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1952,
        224
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const o = $json.output || $json;\nconst ctx = $('Build AI Context').item.json;\nconst num = (v) => { const n = Number(v); return isNaN(n) ? 0 : n; };\nconst clean = (s) => (s || '').toString()\n  .replace(/(\\d)\\s*[\u2013\u2014]\\s*(\\d)/g, '$1 to $2')\n  .replace(/\\s*\u2014\\s*/g, ', ')\n  .replace(/\\s*\u2013\\s*/g, ', ')\n  .replace(/[\u2018\u2019\u02bc\u2032]/g, \"'\")\n  .replace(/[\u201c\u201d]/g, '\"')\n  .replace(/\\r\\n/g, '\\n')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\nconst bad = /(marketing|^pr@|press|media|devteam|no-?reply|protected|cloudflare|@(gmail|yahoo|hotmail|outlook|aol)\\.)/i;\nconst ok = (e) => !!e && /^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$/i.test(e) && !bad.test(e);\nconst pickEmail = (list) => {\n  const arr = (list || '').split(',').map(s => s.trim()).filter(ok);\n  const score = (e) => /^intake@/i.test(e) ? 3 : (/^(info|contact|hello|office|admin)@/i.test(e) ? 2 : 1);\n  arr.sort((a, b) => score(b) - score(a));\n  return arr[0] || '';\n};\nlet email = (o.email || '').toString().trim();\nif (!ok(email)) { email = pickEmail(ctx.foundEmails); }\nif (!email) { const ex = (ctx.existingEmail || '').trim(); if (ok(ex)) email = ex; }\nreturn { json: {\n  recordId: ctx.recordId,\n  email: email,\n  contactName: (o.contactName || '').toString().trim(),\n  fitScore: num(o.fitScore),\n  companySize: o.companySize || 'Unknown',\n  focusAreas: o.focusAreas || '',\n  researchNotes: o.researchNotes || '',\n  hooks: o.hooks || '',\n  draftSubject: clean(o.draftSubject),\n  draftBody: clean(o.draftBody)\n} };"
      },
